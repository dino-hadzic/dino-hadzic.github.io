---
import Layout from "../layouts/Layout.astro";
import { chapters, chaptersByPart } from "../lib/book";

const parts = chaptersByPart();
const preface = chapters.find((chapter) => chapter.slug === "preface");
---

<Layout title="Priručnik za natjecateljsko programiranje">
  <main id="sadrzaj">
    <h1>Priručnik za natjecateljsko programiranje</h1>
    <p class="lead">
      Hrvatski prijevod knjige <em>Competitive Programmer's Handbook</em> autora Anttija
      Laaksonena — uvod u algoritme i tehnike koje se koriste na programerskim natjecanjima.
    </p>

    {
      preface && (
        <ol class="toc">
          <li>
            <a href={`/poglavlje/${preface.slug}/`}>
              <span class="num">—</span>
              <span>{preface.title}</span>
            </a>
          </li>
        </ol>
      )
    }

    {
      parts.map((part) => (
        <section>
          <h2 class="part-title">{part.part}</h2>
          <ol class="toc">
            {part.chapters.map((chapter) => (
              <li>
                <a href={`/poglavlje/${chapter.slug}/`}>
                  <span class="num">{chapter.number}</span>
                  <span>{chapter.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <h2 class="part-title">Dodatno</h2>
    <ol class="toc">
      <li>
        <a href="/literatura/">
          <span class="num">§</span>
          <span>Literatura</span>
        </a>
      </li>
    </ol>
  </main>
</Layout>
