---
import Layout from "../layouts/Layout.astro";
import { references } from "../lib/book";
import { renderMath } from "../lib/math";
---

<Layout title="Literatura · Priručnik za natjecateljsko programiranje">
  <main id="sadrzaj">
    <h1>Literatura</h1>
    <ul class="refs">
      {
        references.map((reference) => (
          <li id={`ref-${reference.key}`}>
            <span class="key">[{reference.key}]</span>{" "}
            <span set:html={renderMath(reference.html)} />
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
